# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# Secret key for Django cryptographic signing
# Generate using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated)
# In production, set to your domain(s)
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# PostgreSQL database URL
# Format: postgres://user:password@host:port/dbname
# For Neon PostgreSQL: Get from Neon dashboard
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory_db

# Individual database settings (alternative to DATABASE_URL)
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# JWT AUTHENTICATION SETTINGS
# =============================================================================

# Secret key for JWT token signing (can be same as SECRET_KEY)
JWT_SECRET=your-jwt-secret-key-here

# Access token lifetime (in minutes)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Refresh token lifetime (in days)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# EMAIL SETTINGS (RESEND)
# =============================================================================

# Resend API key
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Default from email address
# Must be verified in Resend dashboard
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Email backend (smtp for production, console for development)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Email host (for Resend: smtp.resend.com)
EMAIL_HOST=smtp.resend.com

# Email port (for Resend: 587)
EMAIL_PORT=587

# Email use TLS
EMAIL_USE_TLS=True

# Email host user (for Resend: resend)
EMAIL_HOST_USER=resend

# Email host password (for Resend: your API key)
EMAIL_HOST_PASSWORD=re_your_api_key_here

# =============================================================================
# CLOUDFLARE R2 STORAGE SETTINGS
# =============================================================================

# Cloudflare Account ID
# Get from: https://dash.cloudflare.com/[account-id]/r2/overview
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Cloudflare R2 Bucket name
# Create bucket in Cloudflare R2 dashboard
CLOUDFLARE_R2_BUCKET=your-bucket-name

# Cloudflare R2 Access Key
# Generate in Cloudflare R2 dashboard (R2 API Tokens)
CLOUDFLARE_R2_ACCESS_KEY=your-access-key-here

# Cloudflare R2 Secret Key
# Generate in Cloudflare R2 dashboard (R2 API Tokens)
CLOUDFLARE_R2_SECRET_KEY=your-secret-key-here

# Cloudflare R2 Endpoint URL
# Format: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Media files URL
# In production, set to your CDN domain or R2 public URL
MEDIA_URL=https://your-cdn-domain.com/media/

# Static files URL
STATIC_URL=/static/

# =============================================================================
# CORS SETTINGS
# =============================================================================

# CORS allowed origins (comma-separated)
# In production, set to your frontend domain(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS allow credentials
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# REDIS SETTINGS (for Celery)
# =============================================================================

# Redis URL
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secure SSL redirect (True in production)
SECURE_SSL_REDIRECT=False

# Session cookie secure (True in production)
SESSION_COOKIE_SECURE=False

# CSRF cookie secure (True in production)
CSRF_COOKIE_SECURE=False

# HSTS seconds (0 to disable)
SECURE_HSTS_SECONDS=0

# HSTS include subdomains
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# HSTS preload
SECURE_HSTS_PRELOAD=False

# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate limit per minute
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# SENTRY (Optional - for error tracking)
# =============================================================================

# Sentry DSN
# Get from: https://sentry.io/
SENTRY_DSN=

# =============================================================================
# TIMEZONE AND LANGUAGE
# =============================================================================

# Timezone
TIME_ZONE=UTC

# Language code
LANGUAGE_CODE=en-us

# =============================================================================
# LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# CELERY SETTINGS
# =============================================================================

# Celery broker URL
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0
